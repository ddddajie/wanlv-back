<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wanlvback.mapper.VisitorMessageMapper">

    <resultMap id="VisitorMessageResultMap" type="com.example.wanlvback.pojo.entity.VisitorMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="user_id" property="userId"/>
        <result column="message_no" property="messageNo"/>
        <result column="sender_type" property="senderType"/>
        <result column="message_type" property="messageType"/>
        <result column="content" property="content"/>
        <result column="voice_text" property="voiceText"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.wanlvback.pojo.entity.VisitorMessage" useGeneratedKeys="true" keyProperty="id">
        insert into visitor_message (
            session_id,
            user_id,
            message_no,
            sender_type,
            message_type,
            content,
            voice_text,
            create_time
        ) values (
            #{sessionId},
            #{userId},
            #{messageNo},
            #{senderType},
            #{messageType},
            #{content},
            #{voiceText},
            #{createTime}
        )
    </insert>

    <select id="getMaxMessageNoBySessionId" resultType="java.lang.Integer">
        select max(message_no)
        from visitor_message
        where session_id = #{sessionId}
    </select>

    <select id="listBySessionId" resultMap="VisitorMessageResultMap">
        select *
        from visitor_message
        where session_id = #{sessionId}
        order by message_no asc, id asc
    </select>

</mapper>
